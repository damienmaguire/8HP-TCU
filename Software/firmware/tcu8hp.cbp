<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="tcu8hp" />
		<Option makefile_is_custom="1" />
		<Option pch_mode="2" />
		<Option compiler="armelfgcc" />
		<MakeCommands>
			<Build command="make" />
			<CompileFile command="$make -f $makefile $file" />
			<Clean command="$make -f $makefile clean" />
			<DistClean command="$make -f $makefile distclean$target" />
			<AskRebuildNeeded command="$make -q -f $makefile $target" />
			<SilentBuild command="$make -s -f $makefile $target" />
		</MakeCommands>
		<Build>
			<Target title="STM32F107">
				<Option output="stm32_tcu" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/" />
				<Option type="1" />
				<Option compiler="armelfgcc" />
				<Compiler>
					<Add directory="include" />
					<Add directory="libopeninv/include" />
					<Add directory="libopencm3/include" />
				</Compiler>
				<MakeCommands>
					<Build command="make" />
					<CompileFile command="$make -f  $file " />
					<Clean command="make clean " />
					<DistClean command="$make -f $makefile distclean$target" />
					<AskRebuildNeeded command="$make -q" />
					<SilentBuild command="make &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
			<Target title="Test">
				<Option output="test/test_tcu" prefix_auto="0" extension_auto="0" />
				<Option working_dir="test" />
				<Option type="1" />
				<Option compiler="gcc" />
				<MakeCommands>
					<Build command="make Test" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="make cleanTest" />
					<DistClean command="$make -f $makefile distclean$target" />
					<AskRebuildNeeded command="$make -q Test" />
					<SilentBuild command="make Test &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
		</Build>
