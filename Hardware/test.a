#include "SPI.h"
#include "Adafruit_GFX.h"
#include "Adafruit_ILI9341.h"

const int TFT_DC = 3;
const int TFT_CS = 7;
Adafruit_ILI9341 tft = Adafruit_ILI9341(TFT_CS, TFT_DC);


const int SA = 16;      // Solenoid "S-A"
const int SB = 18;      // Solenoid "S-B"
const int SC = 46;       // Solenoid "S-C"
const int SD = 17;       // Solenoid "S-D"
const int SE = 19;       // Solenoid "S-E"
const int SLINE = 43;       // Solenoid "S-LINE"
const int STCC = 45;       // Solenoid "S-TCC"
const int SPARKR = 42;       // Solenoid "S-PARKREL"
const int PARKH = 25;       // Solenoid "S-PARKHL"

const int STemp01 = 13;     //Temp Sensor 01
const int STemp02 = 14;     //Temp Sensor 02

const int GPIN1 = 3;     //TPS 1? or Freq Sensor ZF8 1?
const int GPIN2 = 4;     //TPS 2? or Freq Sensor ZF8 2?




// Run variables

int tpsPosition = 0;
int vehicleSpeed = 0;
int transBrakeLimit = 50;
bool transBrake = false;
bool launchControl = false;

void setup() {
  //Serial.begin(115200);
  //Serial.println("Hello, WOKWI");
  tft.begin();

  tft.setCursor(20, 120);
  tft.setTextColor(ILI9341_RED);
  tft.setTextSize(3);
  tft.println("VAI CAVALO");

  tft.setCursor(24, 160);
  tft.setTextColor(ILI9341_GREEN);
  tft.setTextSize(2);
  tft.println("ZF8HP lol :-)");
}

void loop() { delay(10); }



